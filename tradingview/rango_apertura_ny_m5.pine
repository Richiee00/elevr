//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Rango de apertura NY 9:30–9:45 (equivalente a la vela M15) operado en M5
//
// 1) Rango: máximo más alto y mínimo más bajo (con mechas) de las 3 velas M5
//    de 9:30, 9:35 y 9:40 hora NY.
// 2) Desde las 9:45 se vigila cada vela M5 que TOQUE el máximo o el mínimo:
//    A. Rompe máximo + cierra ≥20 pts DENTRO  → SHORT de reversión
//    B. Rompe máximo + cierra ≥20 pts FUERA   → LONG de continuación
//    C. Rompe mínimo + cierra ≥20 pts FUERA   → SHORT de continuación
//    D. Rompe mínimo + cierra ≥20 pts DENTRO  → LONG de reversión
//    E. Cierra pegada al nivel (<20 pts)      → no se opera
// 3) Filtro: cuerpo ≥ 35% del rango total de la vela.
// 4) SL en el extremo de la vela de señal (o en el cuerpo, opcional):
//    mínimo 40 pts, máximo 120 pts. TP fijo a 1:2.
//
// "Puntos" = unidades de precio (en NQ/ES/US30 1 punto = 1.0 de precio).
// La entrada se ejecuta al cierre de la vela de señal (process_orders_on_close).
// ─────────────────────────────────────────────────────────────────────────────
strategy("Rango Apertura NY 9:30-9:45 (M5)", shorttitle = "NY Rango M5", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ── Inputs ───────────────────────────────────────────────────────────────────
const string TZ = "America/New_York"

grpR = "Rango y horario (hora NY)"
rangeSess = input.session("0930-0945", "Rango de referencia", group = grpR)
entrySess = input.session("0945-1555", "Ventana para buscar entradas", group = grpR)
flatHour  = input.int(15, "Cerrar todo a las (hora)", minval = 0, maxval = 23, group = grpR, inline = "flat")
flatMin   = input.int(55, ":", minval = 0, maxval = 59, group = grpR, inline = "flat")
useFlat   = input.bool(true, "Cerrar posiciones abiertas a esa hora", group = grpR)
maxTrades = input.int(1, "Máximo de operaciones por día", minval = 1, group = grpR)

grpS = "Clasificación de la vela M5"
breakPts = input.float(20.0, "Distancia mínima del cierre al nivel (pts)", minval = 0, group = grpS)
bodyPct  = input.float(35.0, "Cuerpo mínimo (% del rango de la vela)", minval = 0, maxval = 100, group = grpS)
useA = input.bool(true, "Operar A · SHORT reversión (máximo)", group = grpS)
useB = input.bool(true, "Operar B · LONG continuación (máximo)", group = grpS)
useC = input.bool(true, "Operar C · SHORT continuación (mínimo)", group = grpS)
useD = input.bool(true, "Operar D · LONG reversión (mínimo)", group = grpS)

grpRisk = "Stop Loss y Take Profit"
slMode    = input.string("Mecha", "Ubicación del SL", options = ["Mecha", "Cuerpo"], group = grpRisk)
slMin     = input.float(40.0, "SL mínimo (pts)", minval = 0, group = grpRisk)
slMax     = input.float(120.0, "SL máximo (pts)", minval = 0, group = grpRisk)
slMaxMode = input.string("No operar", "Si el SL supera el máximo", options = ["No operar", "Limitar al máximo"], group = grpRisk)
rr        = input.float(2.0, "Ratio TP (R:R 1:x)", minval = 0.1, step = 0.1, group = grpRisk)

grpV = "Visual"
showRange    = input.bool(true, "Mostrar caja del rango 9:30-9:45", group = grpV)
showBands    = input.bool(true, "Mostrar bandas de ±20 pts", group = grpV)
showE        = input.bool(false, "Etiquetar casos E (pegada al nivel)", group = grpV)
showRejected = input.bool(true, "Etiquetar señales descartadas por filtro", group = grpV)
showTable    = input.bool(true, "Mostrar tabla de conteo", group = grpV)

// ── Rango 9:30–9:45 ─────────────────────────────────────────────────────────
inRange  = not na(time(timeframe.period, rangeSess, TZ))
inEntry  = not na(time(timeframe.period, entrySess, TZ))
newRange = inRange and not inRange[1]
rangeEnd = not inRange and inRange[1]

var float rH          = na
var float rL          = na
var bool  rangeReady  = false
var int   rangeStart  = na
var int   tradesToday = 0

if newRange
    rH          := high
    rL          := low
    rangeReady  := false
    rangeStart  := bar_index
    tradesToday := 0
else if inRange
    rH := math.max(rH, high)
    rL := math.min(rL, low)

if rangeEnd
    rangeReady := true
    if showRange
        box.new(rangeStart, rH, bar_index - 1, rL, border_color = color.new(color.orange, 0),
             bgcolor = color.new(color.orange, 85))

// ── Clasificación ───────────────────────────────────────────────────────────
tfOK      = timeframe.period == "5"
candleRng = high - low
bodyOK    = candleRng > 0 and math.abs(close - open) >= bodyPct / 100 * candleRng

touchH = rangeReady and high >= rH
touchL = rangeReady and low <= rL

caseA = touchH and close <= rH - breakPts
caseB = touchH and close >= rH + breakPts
caseC = touchL and close <= rL - breakPts
caseD = touchL and close >= rL + breakPts
caseE = (touchH or touchL) and not (caseA or caseB or caseC or caseD)

longSig  = (caseB and useB) or (caseD and useD)
shortSig = (caseA and useA) or (caseC and useC)
conflict = longSig and shortSig   // vela que barre ambos niveles con señales opuestas

canTrade = tfOK and rangeReady and inEntry and strategy.position_size == 0 and tradesToday < maxTrades

// Distancia de SL ajustada a los límites. Devuelve na si no se debe operar.
slDistance(float raw) =>
    float d = math.max(raw, slMin)
    d > slMax ? (slMaxMode == "Limitar al máximo" ? slMax : na) : d

longRaw  = close - (slMode == "Mecha" ? low  : math.min(open, close))
shortRaw = (slMode == "Mecha" ? high : math.max(open, close)) - close
longDist  = slDistance(longRaw)
shortDist = slDistance(shortRaw)

caseName = caseA ? "A · SHORT reversión" : caseB ? "B · LONG continuación" : caseC ? "C · SHORT continuación" : caseD ? "D · LONG reversión" : "E"

// Conteo de casos (solo velas que se evalúan dentro de la ventana operativa)
var int nA    = 0
var int nB    = 0
var int nC    = 0
var int nD    = 0
var int nE    = 0
var int nFilt = 0

if canTrade
    nA += caseA ? 1 : 0
    nB += caseB ? 1 : 0
    nC += caseC ? 1 : 0
    nD += caseD ? 1 : 0
    nE += caseE ? 1 : 0

// ── Ejecución ───────────────────────────────────────────────────────────────
if canTrade and (longSig or shortSig)
    string reason = conflict ? "Ambos niveles" : not bodyOK ? "Cuerpo < " + str.tostring(bodyPct) + "%" :
         longSig and na(longDist) ? "SL > " + str.tostring(slMax) : shortSig and na(shortDist) ? "SL > " + str.tostring(slMax) : ""
    if reason != ""
        nFilt += 1
        if showRejected
            label.new(bar_index, longSig ? low : high, caseName + "\nDescartada: " + reason,
                 style = longSig ? label.style_label_up : label.style_label_down,
                 color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
    else if longSig
        float sl = close - longDist
        float tp = close + rr * longDist
        strategy.entry("Long", strategy.long, comment = caseB ? "B" : "D")
        strategy.exit("Long SL/TP", from_entry = "Long", stop = sl, limit = tp)
        tradesToday += 1
        label.new(bar_index, low, caseName + "\nSL " + str.tostring(sl, format.mintick) + " (" + str.tostring(longDist) + " pts)\nTP " + str.tostring(tp, format.mintick),
             style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
        line.new(bar_index, sl, bar_index + 12, sl, color = color.red, width = 2)
        line.new(bar_index, tp, bar_index + 12, tp, color = color.green, width = 2)
    else
        float sl = close + shortDist
        float tp = close - rr * shortDist
        strategy.entry("Short", strategy.short, comment = caseA ? "A" : "C")
        strategy.exit("Short SL/TP", from_entry = "Short", stop = sl, limit = tp)
        tradesToday += 1
        label.new(bar_index, high, caseName + "\nSL " + str.tostring(sl, format.mintick) + " (" + str.tostring(shortDist) + " pts)\nTP " + str.tostring(tp, format.mintick),
             style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
        line.new(bar_index, sl, bar_index + 12, sl, color = color.red, width = 2)
        line.new(bar_index, tp, bar_index + 12, tp, color = color.green, width = 2)
else if canTrade and caseE and showE
    label.new(bar_index, touchH ? high : low, "E", style = touchH ? label.style_label_down : label.style_label_up,
         color = color.new(color.gray, 50), textcolor = color.white, size = size.tiny)

// Cierre al final de la sesión
nyMinutes = hour(time, TZ) * 60 + minute(time, TZ)
if useFlat and strategy.position_size != 0 and nyMinutes >= flatHour * 60 + flatMin
    strategy.close_all(comment = "Cierre horario")

// ── Gráficos ────────────────────────────────────────────────────────────────
showLevels = rangeReady and inEntry
plot(showLevels ? rH : na, "Máximo rango", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showLevels ? rL : na, "Mínimo rango", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showLevels and showBands ? rH + breakPts : na, "Máx +20", color = color.new(color.orange, 60), style = plot.style_linebr)
plot(showLevels and showBands ? rH - breakPts : na, "Máx -20", color = color.new(color.orange, 60), style = plot.style_linebr)
plot(showLevels and showBands ? rL + breakPts : na, "Mín +20", color = color.new(color.orange, 60), style = plot.style_linebr)
plot(showLevels and showBands ? rL - breakPts : na, "Mín -20", color = color.new(color.orange, 60), style = plot.style_linebr)

// ── Tabla ───────────────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast and showTable
    table.cell(tbl, 0, 0, tfOK ? "Casos evaluados" : "⚠ Usa gráfico de 5 minutos", text_color = tfOK ? color.white : color.yellow)
    table.cell(tbl, 1, 0, "")
    table.cell(tbl, 0, 1, "A · SHORT reversión",    text_color = color.white)
    table.cell(tbl, 1, 1, str.tostring(nA),         text_color = color.white)
    table.cell(tbl, 0, 2, "B · LONG continuación",  text_color = color.white)
    table.cell(tbl, 1, 2, str.tostring(nB),         text_color = color.white)
    table.cell(tbl, 0, 3, "C · SHORT continuación", text_color = color.white)
    table.cell(tbl, 1, 3, str.tostring(nC),         text_color = color.white)
    table.cell(tbl, 0, 4, "D · LONG reversión",     text_color = color.white)
    table.cell(tbl, 1, 4, str.tostring(nD),         text_color = color.white)
    table.cell(tbl, 0, 5, "E · Pegada (no opera)",  text_color = color.white)
    table.cell(tbl, 1, 5, str.tostring(nE),         text_color = color.white)
    table.cell(tbl, 0, 6, "Descartadas por filtro", text_color = color.white)
    table.cell(tbl, 1, 6, str.tostring(nFilt),      text_color = color.white)
    table.cell(tbl, 0, 7, "Operaciones cerradas",   text_color = color.white)
    table.cell(tbl, 1, 7, str.tostring(strategy.closedtrades), text_color = color.white)
