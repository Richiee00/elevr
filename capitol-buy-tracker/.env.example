# ─────────────────────────────────────────────────────────────
# Capitol Buy Tracker — environment variables
# Copy to .env.local (Next.js) — scripts also read .env.local / .env
# NEVER commit real keys. None of these are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Data mode: "live" (default, uses PostgreSQL) or "mock" (DEVELOPMENT ONLY,
# in-memory fixtures, refused when NODE_ENV=production).
DATA_MODE=live

# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, local…)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/capitol_buy_tracker
# Set to "require" for hosted databases that need TLS (Neon, Supabase…)
DATABASE_SSL=

# Market data provider: fmp | finnhub | alphavantage | twelvedata | polygon | marketstack
# Leave empty to run without prices ("Price data unavailable").
PRICE_PROVIDER=
PRICE_API_KEY=
# Optional overrides
MARKETSTACK_BASE_URL=https://api.marketstack.com/v2
# Max HTTP requests per minute to the price provider (respect your plan)
PRICE_REQUESTS_PER_MINUTE=50
# Skip re-fetching a ticker whose price is younger than this (cache)
PRICE_CACHE_TTL_HOURS=20
# A price older than this is flagged as STALE in the UI
PRICE_STALE_AFTER_HOURS=48
# Max tickers per price-update run (Alpha Vantage free tier ≈ 25/day)
PRICE_MAX_TICKERS_PER_RUN=500

# Capitol Trades ingestion
CAPITOL_TRADES_BFF_URL=https://bff.capitoltrades.com/trades
CAPITOL_TRADES_WEB_URL=https://www.capitoltrades.com/trades
# Pages per run (100 rows/page on the JSON API)
TRADES_MAX_PAGES=30
# Stop paginating after N consecutive pages with no new rows (incremental mode)
TRADES_STOP_AFTER_KNOWN_PAGES=2
TRADES_REQUEST_DELAY_MS=1200

# Secret protecting /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me
